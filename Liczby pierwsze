#include <iostream>
#include <cmath>
using namespace std;
bool pierwsza(int n)
{
    if(n<2) return false;
    for(int d=2; d<=sqrt(n); d++){
        if(n % d == 0) return false; //modulo czyli jak jest reszta z dzielenia to różne od 0
    }
    return true;

}
int main()
{
    int n, liczba;
    cin>>n;

    for (int i=0; i<n; i++){
        cin>>liczba;

    if(pierwsza(liczba))
    {
        cout<<"TAK"<<endl;
    }

    else
    {
        cout<<"NIE"<<endl;
    }

    }

    return 0;
}
