#include <iostream>
#include <cmath>
#include <algorithm>
using namespace std;

const double PI=acos(-1.0); //przechowuje liczbe pi ponieważ acos(-1.0)=pi
const double EPS=1e-9; //zmienna epsilon do przechowania bardzo małej liczby

// Funkcja licząca liczbę rozwiązań dla jednej gałęzi: x = base + 2kπ
long long liczGalezie(long long a,long long b,double base){
    // Szukamy pierwszego k takiego, że base + 2kπ >= a
    long long k;
    if(base>=a-EPS){
        k=0;
        // Zmniejszamy k aż do momentu, gdy znajdziemy pierwsze rozwiązanie >= a
        while(base+2*PI*(k-1)>=a-EPS) {
        k--;
        }
    } else {
        // base < a, więc potrzebujemy k > 0
        k=(long long)ceil((a-base) / (2*PI));

    }

    long long licznik=0;
    while(true){
        double x=base+2*PI*k;
        if(x>b+EPS) break;
        if(x>=a-EPS) licznik++;
        k++;
    }
    return licznik;
}

long long liczRozwiazania(long long a,long long b,double m){
//Jeżeli m jest spoza zakresu [-1,1], wtedy nie ma rozwiązań
    if (fabs(m)>1.0+EPS) return 0;

//obsługuje specjalne przypadki
    //Przypadek m=0
    if(fabs(m)<EPS){ //fabs zwraca wartosc bezwzgledna z m
        // sin(x) = 0 => x = kπ
        // Liczymy liczby całkowite k takie, że a <= kπ <= b
            long long k_min=ceil(a/PI); //zaokrągla w górę
            long long k_max=floor(b/PI); //zaokrągla w dół
            long long result=k_max-k_min+1;
            if(result<0) return 0;
            return result;
    }
    //Przypadek m=1
    if(fabs(m-1.0)<EPS){
        // sin(x) = 1 => x = π/2 + 2kπ
        return liczGalezie(a,b,PI/2.0);
    }

    //Przypadek m=-1
    if(fabs(m+1.0)<EPS){
        // sin(x) = -1 => x = -π/2 + 2kπ
        return liczGalezie(a,b,-PI/2.0);
    }

    // Przypadek ogólny: -1 < m < 1, m ≠ 0
    double alfa=asin(m);
    double beta=PI-alfa;

    //Liczymy rozwiazania dla obu galezi
    long long count1=liczGalezie(a,b,alfa);
    long long count2=liczGalezie(a,b,beta);

    return count1+count2;
}


