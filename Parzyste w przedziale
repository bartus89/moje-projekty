#include <iostream>
using namespace std;
void wypisz_parzyste(int a, int b);
int main() {
    int ile, a, b;
    cin >> ile;

    for (int i = 0; i < ile; i++) {
        cin >> a >> b;
        wypisz_parzyste(a, b);
        cout << endl;
    }
    return 0;
}
void wypisz_parzyste(int a, int b) {
    bool pierwsza = true;
    bool znaleziono = false;

    for (int i = a; i <= b; i++) {
        if (i % 2 == 0) {
            znaleziono = true;
            if (!pierwsza) {
                cout << " ";
            }
            cout << i;
            pierwsza = false;
        }
    }

    if (!znaleziono) {
        cout << "BRAK";
    }
}

